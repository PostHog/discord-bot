[Unit]
Description=Discord -> PostHog analytics bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as a dedicated, unprivileged user (no sudo, no login shell) — NOT the
# hog user, which has passwordless sudo. Create this user at deploy time.
User=discordbot
Group=discordbot
WorkingDirectory=/opt/discord-bot
# DISCORD_TOKEN / DISCORD_CLIENT_ID are read from .env in WorkingDirectory via
# dotenv. DATABASE_PATH is pinned here so the SQLite file lives somewhere the
# service user can write — dotenv won't override an already-set env var.
Environment=NODE_ENV=production
Environment=DATABASE_PATH=/opt/discord-bot/data/bot.sqlite
ExecStart=/usr/bin/node dist/index.js
# Survive crashes and in-box reboots. (Does NOT survive the box being reaped by
# Karpenter consolidation — snapshot the box for that, see README.)
Restart=always
RestartSec=5
# Hardening — the bot needs no privileges and only writes its SQLite dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/discord-bot/data

[Install]
WantedBy=multi-user.target
