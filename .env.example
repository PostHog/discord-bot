# Discord bot credentials (from https://discord.com/developers/applications)
# Bot -> Token
DISCORD_TOKEN=your-bot-token-here
# General Information -> Application ID (also "Client ID")
DISCORD_CLIENT_ID=your-application-id-here

# Path to the SQLite file that stores per-guild configuration.
# Use an absolute path or a volume mount in production so it survives restarts.
DATABASE_PATH=./data/bot.sqlite

# Optional: only used by `npm run deploy-commands -- --guild <id>` for instant
# command registration during development. Not required at runtime.
# DEV_GUILD_ID=
