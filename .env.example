# Discord bot credentials (from https://discord.com/developers/applications)
# Bot -> Token
DISCORD_BOT_TOKEN=your-bot-token-here
# General Information -> Application ID (also "Client ID")
DISCORD_APPLICATION_ID=your-application-id-here

# Path to the SQLite file that stores per-guild configuration.
# Use an absolute path or a volume mount in production so it survives restarts.
DATABASE_PATH=./data/bot.sqlite

# --- PostHog Code bridge (required) ---------------------------------------
# Shared secret used as a bearer token in BOTH directions: the bot sends it
# when forwarding /ph interactions to PostHog, and requires it on inbound calls
# to the actions API. Must match the value configured on the PostHog side.
POSTHOG_DISCORD_SHARED_SECRET=your-shared-secret-here
# host:port the bot's inbound actions API binds to (PostHog -> bot). Use
# 0.0.0.0 to accept connections from off-box, or 127.0.0.1 when fronted by a
# reverse proxy / tunnel.
BOT_ACTIONS_BIND=0.0.0.0:8080
# Dev only: override the PostHog app host the bridge forwards to (otherwise it's
# derived from the guild's analytics region). Point at a tunneled local PostHog.
# POSTHOG_BRIDGE_BASE_URL=http://127.0.0.1:8000

# --- Roadmap ideas (optional) ---------------------------------------------
# `/ph idea` and the "Submit as roadmap idea" message action write to the
# survey behind posthog.com/roadmap. Unlike the rest of the bot this reports to
# ONE fixed project, not the guild's own, so it needs its own credentials.
# Leave ROADMAP_SURVEY_ID unset to switch the feature off; set it and the other
# ROADMAP_* variables below become required.
# ROADMAP_SURVEY_ID=019f8008-6dfe-0000-696a-515c59643b03
# The two question ids of that survey, in order: the idea, then the email.
# ROADMAP_SURVEY_IDEA_QUESTION_ID=d257defb-d875-42fd-8cb6-80845c2bb26f
# ROADMAP_SURVEY_EMAIL_QUESTION_ID=794db2f2-7ed4-4cf2-a8a3-d27df1b85530
# Public project key (phc_...) of the project that holds the survey.
# ROADMAP_POSTHOG_PROJECT_API_KEY=phc_your-key-here
# Capture host for that project (default https://us.i.posthog.com).
# ROADMAP_POSTHOG_HOST=https://us.i.posthog.com
# Comma-separated guild ids allowed to submit. Leave unset ONLY on a private
# install: empty means every server the bot is in can write to the survey.
# ROADMAP_GUILD_IDS=123456789012345678

# Optional: how often the server_snapshot event fires, in hours (default 1).
# One event per server per run, so hourly is cheap; raise it to sample less often,
# at the cost of no longer being able to see presence by hour of day.
# SNAPSHOT_INTERVAL_HOURS=1

# Optional: how often the member_roster sweep runs, in hours (default 24). Each
# run emits one event per member, so lower values cost proportionally more.
# ROSTER_INTERVAL_HOURS=24
